MONGODB_URI=mongodb+srv://titanadmin:titan@cluster0.ywdmrnh.mongodb.net/titan?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development

# JWT ------------------------------------------------------------
# Login routes (admin/trainer/student) ab is secret se signed token
# issue karte hain. Ye ek random 96-char secret hai — kisi ko mat
# bhejo, aur agar kabhi leak ho jaye to yahan naya generate karke
# replace kar dena (purane sab tokens automatically invalid ho jayenge).
JWT_SECRET=titansecret
JWT_EXPIRES_IN=7d

# Email (Nodemailer via Gmail) ------------------------------------
# EMAIL_USER: apna Gmail address.
# EMAIL_PASS: Gmail ka normal password NAHI — ek "App Password" chahiye.
#   Google Account -> Security -> 2-Step Verification (on karo) ->
#   App Passwords -> "Mail" ke liye 16-digit password generate karo,
#   wahi yahan paste karo.
# Ye credentials khali chore doge to email bhejna silently skip ho
# jayega (server crash nahi hoga) — jab ready ho tab fill kar dena.
EMAIL_USER=drhasnain953@gmail.com
EMAIL_PASS=zglxxeovfzzzwfme
EMAIL_FROM_NAME=TITAN - Taj Institute of Technology